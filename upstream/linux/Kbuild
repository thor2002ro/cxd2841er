# Only modules containing local changes; companion objects form complete modules.
obj-m := cxd2841er.o r820t.o mn88472.o mn88473.o rtl2832.o tda18250.o dvb-core.o \
	dvb-usb.o dvb_usb_v2.o dvb-usb-dib0700.o dvb-usb-rtl28xxu.o
ifeq ($(CONFIG_DVB_CORE),y)
obj-m := $(filter-out dvb-core.o,$(obj-m))
endif

cxd2841er-y := drivers/media/dvb-frontends/cxd2841er.o
mn88473-y := drivers/media/dvb-frontends/mn88473.o
mn88472-y := drivers/media/dvb-frontends/mn88472.o
rtl2832-y := drivers/media/dvb-frontends/rtl2832.o
r820t-y := drivers/media/tuners/r820t.o
tda18250-y := drivers/media/tuners/tda18250.o

dvb-core-y := $(addprefix drivers/media/dvb-core/,dvbdev.o dmxdev.o \
	dvb_demux.o dvb_ca_en50221.o dvb_frontend.o dvb_ringbuffer.o)
dvb-core-$(CONFIG_DVB_NET) += drivers/media/dvb-core/dvb_net.o
dvb-core-$(CONFIG_DVB_MMAP) += drivers/media/dvb-core/dvb_vb2.o

dvb-usb-y := $(addprefix drivers/media/usb/dvb-usb/,dvb-usb-firmware.o \
	dvb-usb-init.o dvb-usb-urb.o dvb-usb-i2c.o dvb-usb-dvb.o \
	dvb-usb-remote.o usb-urb.o)
dvb-usb-dib0700-y := $(addprefix drivers/media/usb/dvb-usb/,dib0700_core.o dib0700_devices.o)
dvb_usb_v2-y := $(addprefix drivers/media/usb/dvb-usb-v2/,dvb_usb_core.o dvb_usb_urb.o usb_urb.o)
dvb-usb-rtl28xxu-y := drivers/media/usb/dvb-usb-v2/rtl28xxu.o

ccflags-y += -I$(src)/drivers/media/dvb-frontends -I$(src)/drivers/media/tuners
